# VDP Analytics — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.

# ── AI Models (required for AI Analyst panel) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # claude.ai — Required for Board Report + Analyst
OPENAI_API_KEY=sk-...                 # platform.openai.com — GPT-4o + o3-mini
GOOGLE_AI_API_KEY=AIza...             # aistudio.google.com — Gemini 2.0 / 1.5 Pro
PERPLEXITY_API_KEY=pplx-...           # perplexity.ai — Live web search (Sonar)

# ── External Data (optional — pipeline skips gracefully if missing) ──────────
FRED_API_KEY=...                      # fred.stlouisfed.org/docs/api/api_key.html (free)
EIA_API_KEY=...                       # eia.gov/opendata (free, instant) — CA gas prices

# ── Login (optional — leave blank unless enabling ?login=true) ───────────────
# GOOGLE_CLIENT_ID=...
# MS_CLIENT_ID=...
